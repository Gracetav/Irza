<%- include('../partials/header') %>

<div class="product-detail-container" style="background: white; border-radius: 30px; box-shadow: var(--shadow); padding: 3rem; display: flex; gap: 4rem; flex-wrap: wrap; margin-bottom: 4rem;">
    <div style="flex: 1; min-width: 350px;">
        <div style="position: sticky; top: 120px;">
            <img src="<%= product.image ? '/uploads/products/' + product.image : 'https://dummyimage.com/600x600/f0f0f0/999&text=No+Photo' %>" alt="<%= product.name %>" style="width: 100%; border-radius: 20px; box-shadow: 0 15px 40px rgba(0,0,0,0.1);">
        </div>
    </div>
    <div style="flex: 1.5; min-width: 350px; display: flex; flex-direction: column; justify-content: center;">
        <span style="display: inline-block; padding: 0.4rem 1.2rem; background: #e7f0ff; color: var(--primary); border-radius: 10px; font-weight: 800; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 2rem;">Authentic Sparepart</span>
        <h2 style="font-size: 3rem; font-weight: 800; line-height: 1.1; margin-bottom: 1.5rem; color: var(--dark); letter-spacing: -1px;"><%= product.name %></h2>
        
        <p class="product-price" style="font-size: 2.2rem; color: var(--primary); font-weight: 800; margin-bottom: 2rem;">
            <% if (product.price) { %>
                Rp <%= Number(product.price).toLocaleString('id-ID') %>
            <% } else { %>
                Contact Support
            <% } %>
        </p>
        
        <div style="padding: 1.5rem; background: #fafafa; border-radius: 20px; border: 1px solid #f0f0f0; margin-bottom: 2.5rem;">
          <h4 style="margin-bottom: 1rem; color: #555;">Description</h4>
          <p style="color: #666; font-size: 1.1rem; line-height: 1.8;"><%= product.description || 'Our team is still updating the full technical specifications for this premium part. Rest assured, it meets our ultra-high quality standards.' %></p>
        </div>

        <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 2.5rem; padding-left: 0.5rem;">
            <span style="display: flex; align-items: center; gap: 0.5rem;">
                <div style="width: 12px; height: 12px; border-radius: 50%; background: <%= product.stock > 0 ? '#00c853' : '#ff1744' %>"></div>
                <strong style="color: #444;"><%= product.stock %> in storage</strong>
            </span>
        </div>
        
        <form action="/cart/add" method="POST" style="display: flex; flex-direction: column; gap: 1.5rem;">
            <input type="hidden" name="product_id" value="<%= product.id %>">
            <div style="display: flex; align-items: center; gap: 1rem;">
                <label for="qty" style="font-weight: 700; color: #777; text-transform: uppercase; font-size: 0.8rem;">Select Amount</label>
                <input type="number" name="qty" id="qty" value="1" min="1" max="<%= product.stock %>" required style="width: 100px; padding: 1.2rem; border-radius: 16px; border: 2px solid #eee; text-align: center; font-weight: 800; margin: 0;">
            </div>
            <button type="submit" style="width: 100%; padding: 1.5rem; font-size: 1.1rem; border-radius: 18px; box-shadow: 0 10px 20px rgba(0, 98, 255, 0.2);">Secure Add to Bag</button>
        </form>
    </div>
</div>

<%- include('../partials/footer') %>
