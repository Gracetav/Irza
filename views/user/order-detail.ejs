<%- include('../partials/header') %>

<div class="py-10">
    <!-- Header with Breadcrumb-like Info -->
    <div class="mb-12 flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
            <div class="flex items-center gap-3 mb-4 text-xs font-black text-blue-600 uppercase tracking-[3px]">
                <a href="/orders" class="hover:underline">Orders</a>
                <span>/</span>
                <span class="text-gray-400">Deployment Detail</span>
            </div>
            <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight">Mission #<%= order.id %></h2>
            <p class="text-gray-500 font-medium">Detailed specifications and status for your acquisition.</p>
        </div>
        <div class="flex items-center gap-4">
            <span class="px-6 py-3 rounded-2xl text-xs font-black uppercase tracking-widest border
                <%= order.status === 'confirmed' ? 'bg-green-50 text-green-600 border-green-100' : 
                   order.status === 'pending' ? 'bg-amber-50 text-amber-600 border-amber-100' :
                   'bg-blue-50 text-blue-600 border-blue-100' %>">
                Logistics: <%= order.status %>
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
        <!-- Order Items -->
        <div class="lg:col-span-2 space-y-8">
            <div class="bg-white rounded-[40px] shadow-xl border border-gray-50 overflow-hidden">
                <div class="p-8 border-b border-gray-50 bg-gray-50/30">
                    <h3 class="text-xl font-black text-gray-900">Deployed Components</h3>
                </div>
                <div class="p-8 overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[10px] font-black text-gray-400 uppercase tracking-widest border-b border-gray-100 pb-4">
                                <th class="pb-6">Description</th>
                                <th class="pb-6">Unit Price</th>
                                <th class="pb-6">Qty</th>
                                <th class="pb-6 text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            <% items.forEach(item => { %>
                                <tr>
                                    <td class="py-6 font-black text-gray-900"><%= item.name %></td>
                                    <td class="py-6 text-sm text-gray-500">Rp <%= Number(item.price).toLocaleString('id-ID') %></td>
                                    <td class="py-6 text-sm font-bold text-gray-700">x<%= item.qty %></td>
                                    <td class="py-6 text-right font-black text-gray-900">Rp <%= (item.price * item.qty).toLocaleString('id-ID') %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="3" class="pt-8 text-right text-gray-400 font-bold uppercase tracking-widest text-xs">Total Mission Valuation</td>
                                <td class="pt-8 text-right text-2xl font-black text-blue-600">Rp <%= Number(order.total_price).toLocaleString('id-ID') %></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Transfer Info -->
            <div class="bg-gray-900 rounded-[40px] p-10 text-white shadow-2xl relative overflow-hidden">
                <div class="relative z-10 flex flex-col md:flex-row gap-10">
                    <div class="flex-grow">
                        <h3 class="text-2xl font-black mb-6 flex items-center gap-3">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                            </svg>
                            Financial Interface
                        </h3>
                        <p class="text-gray-400 font-medium mb-8">Execute transfer via one of the following secure protocols:</p>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="p-6 bg-white/5 rounded-3xl border border-white/10 group hover:border-blue-500 transition-all duration-300">
                                <p class="text-[10px] text-gray-500 font-black uppercase tracking-widest mb-1">Bank BCA</p>
                                <p class="text-lg font-black text-white group-hover:text-blue-400 transition-colors">1234567890</p>
                                <p class="text-xs text-gray-500 mt-2 font-bold uppercase tracking-tight">MotoParts Admin</p>
                            </div>
                            <div class="p-6 bg-white/5 rounded-3xl border border-white/10 group hover:border-blue-500 transition-all duration-300">
                                <p class="text-[10px] text-gray-500 font-black uppercase tracking-widest mb-1">BNI Network</p>
                                <p class="text-lg font-black text-white group-hover:text-blue-400 transition-colors">0987654321</p>
                                <p class="text-xs text-gray-500 mt-2 font-bold uppercase tracking-tight">MotoParts Admin</p>
                            </div>
                        </div>
                    </div>
                    <div class="md:w-px bg-white/10"></div>
                    <div class="md:w-48 flex items-center justify-center">
                        <div class="text-center">
                            <p class="text-xs text-blue-400 font-black uppercase tracking-[3px] mb-2">Support</p>
                            <p class="text-xs text-gray-500 font-medium leading-relaxed">Need help? Encrypted chat available 24/7.</p>
                        </div>
                    </div>
                </div>
                <!-- Decorative element -->
                <div class="absolute -bottom-10 -left-10 w-40 h-40 bg-blue-600/10 rounded-full blur-2xl"></div>
            </div>
        </div>

        <!-- Payment Proof Panel -->
        <div class="space-y-8">
            <div class="bg-white rounded-[40px] shadow-xl border border-gray-50 p-10">
                <h3 class="text-2xl font-black text-gray-900 mb-8">Authentication</h3>
                
                <% if (payment) { %>
                    <div class="space-y-6">
                        <div class="flex items-center justify-between p-4 bg-gray-50 rounded-2xl border border-gray-100">
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-widest">Verify Status</span>
                            <span class="px-4 py-1 text-[10px] font-black uppercase tracking-widest rounded-full 
                                <%= payment.status === 'confirmed' ? 'bg-green-100 text-green-700' : 'bg-amber-100 text-amber-700' %>">
                                <%= payment.status %>
                            </span>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-4">Uploaded Submission</p>
                            <div class="rounded-3xl overflow-hidden shadow-lg border border-gray-100 group cursor-zoom-in">
                                <img src="/uploads/payments/<%= payment.proof %>" alt="Proof" class="w-full h-auto group-hover:scale-105 transition-transform duration-700">
                            </div>
                        </div>
                    </div>
                <% } else { %>
                    <div class="text-center py-6">
                        <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mx-auto mb-6">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
                            </svg>
                        </div>
                        <p class="text-gray-400 font-bold mb-8 text-sm">Waiting for visual data proof of transfer.</p>
                        <form action="/upload-proof" method="POST" enctype="multipart/form-data" class="space-y-6 text-left">
                            <input type="hidden" name="order_id" value="<%= order.id %>">
                            <div class="relative group">
                                <input type="file" name="proof" id="proof" required class="absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10">
                                <div class="w-full py-10 bg-gray-50 border-2 border-dashed border-gray-200 rounded-2xl flex flex-col items-center justify-center group-hover:bg-blue-50 group-hover:border-blue-200 transition-all duration-300">
                                    <span class="text-xs font-black text-blue-600 uppercase tracking-widest">Capture Image</span>
                                    <p class="text-[10px] text-gray-400 mt-2">JPG, PNG allowed</p>
                                </div>
                            </div>
                            <button type="submit" class="w-full py-5 bg-blue-600 hover:bg-black text-white font-extrabold rounded-2xl shadow-xl shadow-blue-200 transition-all duration-300 transform active:scale-95 uppercase tracking-wider text-sm flex items-center justify-center gap-3">
                                Upload Evidence
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                                </svg>
                            </button>
                        </form>
                    </div>
                <% } %>
            </div>
            
            <div class="p-8 bg-blue-50 rounded-[40px] border border-blue-100">
                <h4 class="text-sm font-black text-blue-900 uppercase tracking-widest mb-2">Mission Protocol</h4>
                <p class="text-xs text-blue-700/70 font-medium leading-relaxed">Once evidence is uploaded, our logistics team will verify the acquisition within 2-4 hours before initiating deployment.</p>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
