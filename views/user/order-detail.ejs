<%- include('../partials/header') %>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2>Order #<%= order.id %> Details</h2>
        <span class="badge badge-<%= order.status %>" style="font-size: 1rem;"><%= order.status.toUpperCase() %></span>
    </div>

    <div style="margin-bottom: 2rem;">
        <h3>Order Items</h3>
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                <% items.forEach(item => { %>
                    <tr>
                        <td><%= item.name %></td>
                        <td>Rp <%= item.price.toLocaleString('id-ID') %></td>
                        <td><%= item.qty %></td>
                        <td>Rp <%= (item.price * item.qty).toLocaleString('id-ID') %></td>
                    </tr>
                <% }) %>
            </tbody>
            <tfoot>
                <tr style="font-weight: bold; background-color: #f9f9f9;">
                    <td colspan="3" style="text-align: right;">Total Price:</td>
                    <td>Rp <%= order.total_price.toLocaleString('id-ID') %></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
        <div class="card" style="box-shadow: none; border: 1px solid #ddd;">
            <h3>Payment Status</h3>
            <% if (payment) { %>
                <p>Status: <span class="badge badge-<%= payment.status %>"><%= payment.status %></span></p>
                <div style="margin-top: 1rem;">
                    <p>Proof of Payment:</p>
                    <img src="/uploads/payments/<%= payment.proof %>" alt="Proof" style="width: 100%; border-radius: 4px; margin-top: 0.5rem; border: 1px solid #ddd;">
                </div>
            <% } else { %>
                <p style="color: #666; margin: 1rem 0;">No proof of payment uploaded yet.</p>
                <form action="/upload-proof" method="POST" enctype="multipart/form-data">
                    <input type="hidden" name="order_id" value="<%= order.id %>">
                    <label for="proof">Upload Payment Proof (JPG/PNG)</label>
                    <input type="file" name="proof" id="proof" required style="margin-bottom: 1rem; border: 1px dashed #007bff; padding: 1.5rem; border-radius: 4px; text-align: center;">
                    <button type="submit" class="btn-success">Upload Now</button>
                </form>
            <% } %>
        </div>

        <div class="card" style="box-shadow: none; border: 1px solid #ddd;">
            <h3>Transfer Information</h3>
            <p>Please transfer the total amount to one of our accounts:</p>
            <ul style="margin-top: 1rem; list-style: none;">
                <li style="margin-bottom: 0.5rem;"><strong>Bank BCA:</strong> 1234567890 (A/N MotoParts)</li>
                <li style="margin-bottom: 0.5rem;"><strong>Bank Mandiri:</strong> 0987654321 (A/N MotoParts)</li>
                <li style="margin-bottom: 0.5rem;"><strong>DANA/OVO:</strong> 0812-3456-7890</li>
            </ul>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
