<%- include('../partials/header') %>

<!-- Hero Banner -->
<section class="hero-banner">
    <div class="hero-content">
        <h2>Premium MotoParts Excellence</h2>
        <p>Your ultimate destination for high-performance and original motorcycle spare parts. Elevate your riding experience today.</p>
        <a href="#catalog" class="btn" style="background: white; color: var(--primary); padding: 1.2rem 2.5rem; border-radius: 50px; font-weight: 800; font-size: 1.1rem; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">Explore Catalog</a>
    </div>
</section>

<!-- Features Section -->
<section class="features-container">
    <div class="feature-box">
        <div style="width: 80px; height: 80px; background: #e7f0ff; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <span style="font-size: 2.5rem;">🛡️</span>
        </div>
        <h4>100% Genuine</h4>
        <p>Premium quality guaranteed products directly from manufacturers.</p>
    </div>
    <div class="feature-box">
        <div style="width: 80px; height: 80px; background: #fff4e5; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <span style="font-size: 2.5rem;">⚡</span>
        </div>
        <h4>Instant Delivery</h4>
        <p>Hyper-local fast shipping within hours for selected areas.</p>
    </div>
    <div class="feature-box">
        <div style="width: 80px; height: 80px; background: #e6ffef; border-radius: 20px; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <span style="font-size: 2.5rem;">🔒</span>
        </div>
        <h4>Secure Checkout</h4>
        <p>End-to-end encrypted transactions for your peace of mind.</p>
    </div>
</section>

<!-- Product Catalog -->
<section id="catalog">
    <div class="catalog-header">
        <p>Exclusive Selections</p>
        <h2>Our Featured Parts</h2>
    </div>

    <div class="product-grid">
        <% if (!products || products.length === 0) { %>
            <div style="grid-column: 1 / -1; text-align: center; padding: 6rem; background: white; border-radius: 30px; box-shadow: var(--shadow);">
                <span style="font-size: 4rem; display: block; margin-bottom: 1rem;">📦</span>
                <h3 style="color: #333; margin-bottom: 0.5rem;">No Products Available</h3>
                <p style="color: #999;">Check back later for new arrivals.</p>
            </div>
        <% } else { %>
            <% products.forEach(product => { %>
                <div class="product-card">
                    <div class="product-image-wrapper">
                        <img src="<%= product.image ? '/uploads/products/' + product.image : 'https://dummyimage.com/600x600/f0f0f0/999&text=No+Photo' %>" alt="<%= product.name %>">
                    </div>
                    <div class="product-info">
                        <h3><%= product.name %></h3>
                        <p class="product-price">
                            <% if (product.price) { %>
                                Rp <%= Number(product.price).toLocaleString('id-ID') %>
                            <% } else { %>
                                Contact Support
                            <% } %>
                        </p>
                        
                        <div class="product-actions">
                            <a href="/product/<%= product.id %>" class="btn btn-detail" style="flex: 1;">Detail</a>
                            <form action="/cart/add" method="POST" style="flex: 1; margin: 0;">
                                <input type="hidden" name="product_id" value="<%= product.id %>">
                                <input type="hidden" name="qty" value="1">
                                <button type="submit" style="width: 100%;">Add to Cart</button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</section>

<%- include('../partials/header') %> <!-- Logic error in the original file had header at end too? Replaced with footer below -->
<%- include('../partials/footer') %>
