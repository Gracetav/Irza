<%- include('../partials/header') %>

<div class="py-10">
    <div class="mb-12">
        <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight">Your Equipment Bag</h2>
        <p class="text-gray-500 font-medium">Review your selected components before mission deployment.</p>
    </div>
    
    <% if (!cart || cart.length === 0) { %>
        <div class="bg-white rounded-[40px] p-20 text-center shadow-xl border border-gray-50">
            <div class="w-32 h-32 bg-gray-50 rounded-full flex items-center justify-center mx-auto mb-8">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
                </svg>
            </div>
            <h3 class="text-2xl font-black text-gray-900 mb-4">Bag is Empty</h3>
            <p class="text-gray-400 mb-10 max-w-sm mx-auto">It seems you haven't selected any performance parts for your motorcycle yet.</p>
            <a href="/" class="inline-flex items-center gap-3 px-8 py-4 bg-blue-600 text-white font-extrabold rounded-2xl hover:bg-black transition-all duration-300">
                Back to Catalog
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-12">
            <!-- Items List -->
            <div class="xl:col-span-2 space-y-6">
                <% let totalAll = 0; %>
                <% cart.forEach(item => { %>
                    <% totalAll += (item.price * item.qty); %>
                    <div class="bg-white p-6 md:p-8 rounded-[40px] shadow-sm border border-gray-50 flex flex-col md:flex-row items-center gap-8 group hover:shadow-xl hover:shadow-blue-50/50 transition-all duration-500">
                        <div class="w-24 md:w-32 h-24 md:h-32 bg-gray-50 rounded-[30px] overflow-hidden flex-shrink-0 group-hover:scale-105 transition-transform duration-500 border border-gray-100">
                            <img src="<%= item.image ? '/uploads/products/' + item.image : 'https://dummyimage.com/200x200/f0f0f0/999&text=Part' %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                        </div>
                        
                        <div class="flex-grow flex flex-col md:flex-row md:items-center justify-between gap-6 w-full">
                            <div>
                                <h4 class="text-xl font-black text-gray-900 mb-1"><%= item.name %></h4>
                                <p class="text-blue-600 font-bold mb-4 md:mb-0">Rp <%= Number(item.price).toLocaleString('id-ID') %></p>
                                <a href="/cart/remove/<%= item.id %>" onclick="return confirm('Eject this item?')" class="text-xs font-black text-rose-500 hover:text-rose-700 uppercase tracking-widest flex items-center gap-2 mt-2">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                    Remove Part
                                </a>
                            </div>

                            <div class="flex items-center gap-8">
                                <form action="/cart/update" method="POST" class="flex items-center bg-gray-100 rounded-2xl p-1 gap-2 border border-gray-200">
                                    <input type="hidden" name="id" value="<%= item.id %>">
                                    <button type="button" onclick="const i = this.nextElementSibling; i.stepDown(); i.dispatchEvent(new Event('change'));" class="w-10 h-10 flex items-center justify-center hover:bg-white rounded-xl transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M20 12H4" /></svg>
                                    </button>
                                    <input type="number" name="qty" value="<%= item.qty %>" min="1" onchange="this.form.submit()" class="w-12 bg-transparent text-center font-black text-gray-800 outline-none border-none [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none">
                                    <button type="button" onclick="const i = this.previousElementSibling; i.stepUp(); i.dispatchEvent(new Event('change'));" class="w-10 h-10 flex items-center justify-center hover:bg-white rounded-xl transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4" /></svg>
                                    </button>
                                </form>
                                <p class="text-right font-black text-gray-900 min-w-[120px]">
                                    Rp <%= (item.price * item.qty).toLocaleString('id-ID') %>
                                </p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Summary Card -->
            <div class="bg-gray-900 rounded-[40px] p-10 h-fit text-white sticky top-32 shadow-2xl">
                <h3 class="text-2xl font-black mb-8">Mission Summary</h3>
                <div class="space-y-6 mb-10">
                    <div class="flex justify-between items-center text-gray-500 font-bold uppercase tracking-widest text-xs">
                        <span>Subtotal</span>
                        <span>Rp <%= totalAll.toLocaleString('id-ID') %></span>
                    </div>
                    <div class="flex justify-between items-center text-gray-500 font-bold uppercase tracking-widest text-xs">
                        <span>Logistics Fee</span>
                        <span class="text-blue-400">Calculated later</span>
                    </div>
                    <div class="h-px bg-gray-800"></div>
                    <div class="flex justify-between items-end">
                        <span class="text-gray-400 font-black uppercase tracking-[3px] text-xs">Final Valuation</span>
                        <span class="text-3xl font-black text-white">Rp <%= totalAll.toLocaleString('id-ID') %></span>
                    </div>
                </div>

                <form action="/checkout" method="POST">
                    <button type="submit" class="w-full py-5 bg-blue-600 hover:bg-white hover:text-blue-600 text-white font-extrabold rounded-2xl transition-all duration-500 transform shadow-xl shadow-blue-900/40 uppercase tracking-widest flex items-center justify-center gap-3 group">
                        Confirm & Deploy
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </button>
                </form>
                
                <p class="text-center text-[10px] text-gray-600 mt-6 font-bold uppercase tracking-widest">Secure transaction protocol enabled</p>
            </div>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
