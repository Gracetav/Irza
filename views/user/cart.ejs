<%- include('../partials/header') %>

<div class="card">
    <h2 style="margin-bottom: 2rem;">Shopping Cart</h2>
    
    <% if (cart.length === 0) { %>
        <p>Your cart is empty. <a href="/" style="color: #007bff;">Continue shopping</a></p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <% let totalAll = 0; %>
                <% cart.forEach(item => { %>
                    <% totalAll += (item.price * item.qty); %>
                    <tr>
                        <td style="display: flex; align-items: center; gap: 1rem;">
                            <img src="<%= item.image ? '/uploads/products/' + item.image : 'https://dummyimage.com/100x100/ddd/000&text=No+Photo' %>" alt="<%= item.name %>" style="width: 60px; height: 60px; object-fit: cover; border-radius: 4px;">
                            <span><%= item.name %></span>
                        </td>
                        <td>Rp <%= item.price.toLocaleString('id-ID') %></td>
                        <td>
                            <form action="/cart/update" method="POST" style="margin: 0;">
                                <input type="hidden" name="id" value="<%= item.id %>">
                                <input type="number" name="qty" value="<%= item.qty %>" min="1" style="width: 70px; padding: 0.5rem; margin: 0;" onchange="this.form.submit()">
                            </form>
                        </td>
                        <td>Rp <%= (item.price * item.qty).toLocaleString('id-ID') %></td>
                        <td>
                            <a href="/cart/remove/<%= item.id %>" style="color: #dc3545;" onclick="return confirm('Are you sure?')">Remove</a>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
            <tfoot>
                <tr style="font-weight: bold; background-color: #f9f9f9;">
                    <td colspan="3" style="text-align: right;">Total All:</td>
                    <td colspan="2">Rp <%= totalAll.toLocaleString('id-ID') %></td>
                </tr>
            </tfoot>
        </table>

        <div style="margin-top: 2rem; display: flex; justify-content: flex-end;">
            <form action="/checkout" method="POST">
                <button type="submit" style="padding: 1rem 3rem;">Proceed to Checkout</button>
            </form>
        </div>
    <% } %>
</div>

<%- include('../partials/footer') %>
