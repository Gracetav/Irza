<%- include('partials/header') %>

<div class="flex items-center justify-center min-h-[70vh]">
    <div class="w-full max-w-md p-8 bg-white rounded-[30px] shadow-2xl shadow-blue-100 border border-gray-100 mt-10">
        <div class="text-center mb-10">
            <h2 class="text-4xl font-extrabold text-gray-900 tracking-tight mb-3">Welcome Back</h2>
            <p class="text-gray-500 font-medium">Precision parts for your performance machine.</p>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="p-4 mb-6 text-sm text-red-700 bg-red-50 border border-red-100 rounded-2xl flex items-center gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
                <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST" class="space-y-6">
            <div>
                <label for="email" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 px-1">Email Connection</label>
                <input type="email" name="email" id="email" required placeholder="name@example.com" 
                    class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent focus:border-blue-500 focus:bg-white rounded-2xl transition-all duration-300 outline-none font-bold text-gray-700">
            </div>

            <div>
                <label for="password" class="block text-xs font-bold text-gray-400 uppercase tracking-widest mb-2 px-1">Security Key</label>
                <input type="password" name="password" id="password" required placeholder="••••••••" 
                    class="w-full px-6 py-4 bg-gray-50 border-2 border-transparent focus:border-blue-500 focus:bg-white rounded-2xl transition-all duration-300 outline-none font-bold text-gray-700">
            </div>

            <button type="submit" 
                class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white font-extrabold rounded-2xl shadow-lg shadow-blue-200 transition-all duration-300 transform active:scale-95 uppercase tracking-wider text-sm">
                Authenticate
            </button>
        </form>

        <div class="mt-10 text-center">
            <p class="text-gray-500 font-medium">New pilot? 
                <a href="/register" class="text-blue-600 font-extrabold hover:underline underline-offset-4 ml-1">Create Account</a>
            </p>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
