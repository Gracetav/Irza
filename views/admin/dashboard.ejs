<%- include('../partials/header') %>

<div style="margin-bottom: 2rem;">
    <h2>Admin Dashboard</h2>
    <p>Welcome back, Admin. Here is the overview of the store.</p>
</div>

<div class="dashboard-grid">
    <div class="dashboard-card" style="background-color: #007bff;">
        <h3><%= stats.users %></h3>
        <p>Total Customers</p>
    </div>
    <div class="dashboard-card" style="background-color: #28a745;">
        <h3><%= stats.products %></h3>
        <p>Managed Products</p>
    </div>
    <div class="dashboard-card" style="background-color: #ffc107;">
        <h3><%= stats.pending %></h3>
        <p>Pending Orders</p>
    </div>
    <div class="dashboard-card" style="background-color: #17a2b8;">
        <h3><%= stats.orders %></h3>
        <p>Total Orders</p>
    </div>
</div>

<div style="margin-top: 3rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
    <div class="card">
        <h3>Quick Actions</h3>
        <ul style="list-style: none; margin-top: 1rem;">
            <li style="margin-bottom: 1rem;"><a href="/admin/products" class="btn" style="display: block; text-align: center; background-color: #007bff; color: white; padding: 0.8rem; border-radius: 4px;">Update Stock / Add Products</a></li>
            <li style="margin-bottom: 1rem;"><a href="/admin/orders" class="btn" style="display: block; text-align: center; background-color: #ffc107; color: white; padding: 0.8rem; border-radius: 4px;">Confirm Pending Orders</a></li>
            <li><a href="/admin/users" class="btn" style="display: block; text-align: center; background-color: #dc3545; color: white; padding: 0.8rem; border-radius: 4px;">Manage All Users</a></li>
        </ul>
    </div>
    <div class="card">
        <h3>System Status</h3>
        <p style="margin-top: 1rem;">Running on Node.js + MySQL</p>
        <p>Database: motoparts_db</p>
        <p>Time: <%= new Date().toLocaleString() %></p>
    </div>
</div>

<%- include('../partials/footer') %>
