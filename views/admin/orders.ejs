<%- include('../partials/header') %>

<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
        <h2>Order Confirmation</h2>
        <p>Review orders and payment proofs here.</p>
    </div>

    <% if (orders.length === 0) { %>
        <p>No orders found at the moment.</p>
    <% } else { %>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Customer Name</th>
                    <th>Total Price</th>
                    <th>Status</th>
                    <th>Proof of Payment</th>
                    <th>Update Status</th>
                </tr>
            </thead>
            <tbody>
                <% orders.forEach(order => { %>
                    <tr>
                        <td>#<%= order.id %></td>
                        <td><%= order.user_name %></td>
                        <td>Rp <%= order.total_price.toLocaleString('id-ID') %></td>
                        <td>
                            <span class="badge badge-<%= order.status %>"><%= order.status %></span>
                        </td>
                        <td>
                            <% if (order.proof) { %>
                                <a href="/uploads/payments/<%= order.proof %>" target="_blank" style="color: #007bff; text-decoration: underline;">View Proof</a>
                            <% } else { %>
                                <span style="color: #999;">No Proof Yet</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (order.status === 'pending') { %>
                                <form action="/admin/orders/status" method="POST" style="display: flex; gap: 0.5rem; margin: 0;">
                                    <input type="hidden" name="order_id" value="<%= order.id %>">
                                    <button type="submit" name="status" value="confirmed" class="btn-success" style="padding: 0.5rem; font-size: 0.8rem;">Confirm</button>
                                    <button type="submit" name="status" value="rejected" class="btn-danger" style="padding: 0.5rem; font-size: 0.8rem;">Reject</button>
                                </form>
                            <% } else if (order.status === 'confirmed') { %>
                                <form action="/admin/orders/status" method="POST" style="margin: 0;">
                                    <input type="hidden" name="order_id" value="<%= order.id %>">
                                    <input type="hidden" name="status" value="shipped">
                                    <button type="submit" class="btn-success" style="padding: 0.5rem; font-size: 0.8rem; background-color: #007bff;">Barang sudah dikirim</button>
                                </form>
                            <% } else if (order.status === 'shipped') { %>
                                <span style="color: #666; font-size: 0.8rem;">📦 Sedang Dikirim</span>
                            <% } else { %>
                                <span style="color: #999; font-size: 0.8rem;">Closed</span>
                            <% } %>
                        </td>

                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } %>
</div>

<%- include('../partials/footer') %>
